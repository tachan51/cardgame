      "steps": [
        {"type": "castSpell", "player": "A", "card": "AC-01", "targets": {"cell": {"cell": "B:2前"}}},
        {"expect": {"activePlayer": "B", "A": {"delayed": ["AC-01"], "spellsCast": 1, "mana": 2, "hand": []}, "B": {"board": {"2前": {"damage": 0}}}}},
        {"type": "pass", "player": "B"}
      ],
      "expect": {"activePlayer": "B", "A": {"delayed": [], "trash": ["AC-01"]}, "B": {"board": {"2前": {"card": "KN-04", "damage": 1, "health": 2}}}}
    },
    {
