    {
      "name": "6.2 行動フェイズの流れ（双方が続けてパスしたら戦闘、次のラウンドは先手が入れ替わる）",
      "refs": [
        "6.1",
        "6.2",
        "6.4"
      ],
      "setup": {
        "round": 3,
        "A": {
          "maxMana": 4,
          "hand": [
            "KN-03",
            "AC-05"
          ]
        },
        "B": {
          "maxMana": 3,
          "hand": [
            "KN-04"
          ]
        }
      },
      "steps": [
        {
          "type": "playUnit",
          "player": "A",
          "card": "KN-03",
          "cell": "1前"
