        {
          "type": "castSpell",
          "player": "A",
          "card": "AC-05"
        },
        {
          "expect": {
            "passStreak": 0,
            "A": {
              "hand": [
                "KN-03"
              ],
              "spellsCast": 1
            }
          }
        },
        {
          "type": "playUnit",
          "player": "B",
          "card": "KN-04",
          "cell": "1前"
        },
        {
          "type": "pass",
          "player": "A"
        },
        {
          "expect": {
            "round": 3
          }
        },
        {
          "type": "pass",
          "player": "B"
        }
