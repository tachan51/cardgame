      "expect": {"A": {"mana": 0, "hand": ["CY-04"], "deckCount": 1, "board": {"1後": {"card": "CY-10", "keywords": ["mobile"]}}}}
    },
    {
      "name": "路地裏の運び屋: 山札が0枚なら何も引かず、敗北もしない",
      "refs": ["CY-10", "11.6", "9.1"],
      "setup": {"A": {"mana": 3, "hand": ["CY-10"], "deck": []}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-10", "cell": "1後"}
      ],
      "expect": {"result": null, "A": {"hand": [], "deckCount": 0, "board": {"1後": {"card": "CY-10"}}}}
    },
    {
      "name": "EMPグレネード: 遅延で指定レーンの敵ユニットすべてに2ダメージ（味方・他レーンは無傷）",
      "refs": ["CY-11", "14.1"],
      "setup": {"A": {"mana": 4, "hand": ["CY-11"], "board": {"2前": "KN-04"}}, "B": {"board": {"2前": "KN-03", "2後": "KN-04", "1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-11", "targets": {"lane": {"lane": 2}}},
        {"expect": {"A": {"delayed": ["CY-11"]}}},
        {"type": "pass", "player": "B"}
