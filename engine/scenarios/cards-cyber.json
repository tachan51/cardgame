      "expect": {"activePlayer": "B", "A": {"delayed": [], "trash": ["CY-09"], "leaders": [{}, {"progress": 0}]}, "B": {"board": {"1前": {"card": "KN-03"}, "4後": {"card": "KN-04"}}}}
    },
    {
      "name": "転送遅延: 味方も選べる。移動先はそのユニットの持ち主の盤面の空きマスだけ",
      "refs": ["CY-09", "12"],
      "setup": {"A": {"mana": 3, "hand": ["CY-09"], "board": {"1前": "CY-05", "2後": "KN-04"}}, "B": {"board": {"2前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "A:1前"}, "cell": {"cell": "B:1後"}}, "illegal": true},
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "A:1前"}, "cell": {"cell": "A:2後"}}, "illegal": true},
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "A:1前"}, "cell": {"cell": "A:4後"}}},
        {"type": "pass", "player": "B"}
      ],
      "expect": {"activePlayer": "B", "A": {"trash": ["CY-09"], "board": {"1前": null, "4後": {"card": "CY-05"}, "2後": {"card": "KN-04"}}, "leaders": [{}, {"progress": 1}]}}
