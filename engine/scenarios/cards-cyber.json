{
  "description": "電脳都市（CY-01〜CY-25）とリーダー・レイのカード効果のシナリオ",
  "scenarios": [
    {
      "name": "偵察ドローン: 1マナ 0/1。遊撃で任意の空きマスへ移動できる（1ラウンド1回）",
      "refs": ["CY-01", "14", "7.6"],
      "setup": {"A": {"mana": 1, "hand": ["CY-01"]}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-01", "cell": "2前"},
        {"expect": {"A": {"mana": 0, "board": {"2前": {"card": "CY-01", "attack": 0, "health": 1, "keywords": ["mobile"]}}}}},
        {"type": "pass", "player": "B"},
        {"type": "mobileMove", "player": "A", "unit": "2前", "to": "4後"},
        {"expect": {"A": {"board": {"2前": null, "4後": {"card": "CY-01"}}}}},
        {"type": "pass", "player": "B"},
        {"type": "mobileMove", "player": "A", "unit": "4後", "to": "1前", "illegal": true}
      ],
      "expect": {"activePlayer": "A", "A": {"board": {"4後": {"card": "CY-01"}, "1前": null}}}
    },
    {
      "name": "緊急ログアウト: 味方を手札に戻すとダメージ・強化・盾が消え、即効で続けて行動できる",
      "refs": ["CY-02", "11.7", "14.2"],
      "setup": {"A": {"mana": 3, "hand": ["CY-02"], "board": {"1前": {"card": "KN-04", "damage": 1, "attack": 1, "keywords": ["shield"]}}}, "B": {"board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-02", "targets": {"ally": {"unit": "B:1前"}}, "illegal": true},
        {"type": "castSpell", "player": "A", "card": "CY-02", "targets": {"ally": {"unit": "A:1前"}}},
        {"expect": {"activePlayer": "A", "A": {"mana": 2, "hand": ["KN-04"], "trash": ["CY-02"], "board": {"1前": null}}}},
        {"type": "playUnit", "player": "A", "card": "KN-04", "cell": "2前"}
      ],
      "expect": {"activePlayer": "B", "A": {"mana": 0, "board": {"2前": {"card": "KN-04", "attack": 2, "health": 3, "damage": 0, "shield": false}}}}
    },
    {
      "name": "緊急ログアウト: トークン（効果で出したユニット）も、そのカードとして手札に戻り、また使える",
      "refs": ["CY-02", "11.7"],
      "setup": {"A": {"mana": 2, "hand": ["CY-02"], "board": {"2前": {"card": "TK-01", "token": true, "damage": 3}}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-02", "targets": {"ally": {"unit": "A:2前"}}},
        {"expect": {"activePlayer": "A", "A": {"mana": 1, "hand": ["TK-01"], "trash": ["CY-02"], "board": {"2前": null}}}},
        {"type": "playUnit", "player": "A", "card": "TK-01", "cell": "3前"}
      ],
      "expect": {"A": {"mana": 0, "hand": [], "board": {"3前": {"card": "TK-01", "attack": 5, "health": 5, "damage": 0}}}}
    },
    {
      "name": "緊急ログアウト: 偵察ドローンのトークンも手札に戻る",
      "refs": ["CY-02", "CY-01", "11.7"],
      "setup": {"A": {"mana": 1, "hand": ["CY-02"], "board": {"2前": {"card": "CY-01", "token": true}}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-02", "targets": {"ally": {"unit": "A:2前"}}}
      ],
      "expect": {"activePlayer": "A", "A": {"hand": ["CY-01"], "trash": ["CY-02"], "board": {"2前": null}}}
    },
    {
      "name": "警備ドローンMk-II: 2マナ 2/1 遊撃（ドローン属性）。起動能力はない",
      "refs": ["CY-03", "7.6", "15.2"],
      "setup": {"A": {"mana": 2, "hand": ["CY-03"]}, "B": {"board": {"1前": "KN-04"}}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-03", "cell": "2前"},
        {"expect": {"A": {"mana": 0, "board": {"2前": {"card": "CY-03", "attack": 2, "health": 1, "keywords": ["mobile"], "noKeywords": ["firstStrike"]}}}}},
        {"type": "pass", "player": "B"},
        {"type": "activate", "player": "A", "unit": "2前", "illegal": true},
        {"type": "mobileMove", "player": "A", "unit": "2前", "to": "1前"},
        {"do": "combat"}
      ],
      "expect": {"A": {"board": {"1前": null}, "trash": ["CY-03"]}, "B": {"board": {"1前": {"card": "KN-04", "damage": 2, "health": 1}}}}
    },
    {
      "name": "ストリートサムライ: 先制で正面の2/3を倒し、反撃を受けない",
      "refs": ["CY-04", "8.1"],
      "setup": {"A": {"mana": 2, "hand": ["CY-04"]}, "B": {"board": {"1前": "KN-04"}}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-04", "cell": "1前"},
        {"do": "combat"}
      ],
      "expect": {"A": {"mana": 0, "board": {"1前": {"card": "CY-04", "attack": 3, "health": 1, "damage": 0}}}, "B": {"board": {"1前": null}, "trash": ["KN-04"]}}
    },
    {
      "name": "ストリートサムライ: 体力1なので、先制で倒しきれない相手（2/4）の反撃で破壊される",
      "refs": ["CY-04", "8.1", "10.3"],
      "setup": {"A": {"mana": 2, "hand": ["CY-04"]}, "B": {"board": {"1前": "KN-08"}}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-04", "cell": "1前"},
        {"expect": {"A": {"board": {"1前": {"card": "CY-04", "attack": 3, "health": 1}}}}},
        {"do": "combat"}
      ],
      "expect": {"A": {"board": {"1前": null}, "trash": ["CY-04"]}, "B": {"life": 20, "board": {"1前": {"card": "KN-08", "damage": 3, "health": 1}}}}
    },
    {
      "name": "ジャミング技師: 2/3。配置時の効果はない（正面の敵の攻撃力は変わらず、殴り合う）",
      "refs": ["CY-05", "7.1", "8.4"],
      "setup": {"A": {"mana": 2, "hand": ["CY-05"]}, "B": {"board": {"1前": "KN-04"}}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-05", "cell": "1前"},
        {"expect": {"activePlayer": "B", "A": {"mana": 0, "hand": [], "board": {"1前": {"card": "CY-05", "attack": 2, "health": 3}}}, "B": {"board": {"1前": {"card": "KN-04", "attack": 2}}}}},
        {"do": "combat"}
      ],
      "expect": {"A": {"board": {"1前": {"card": "CY-05", "damage": 2, "health": 1}}}, "B": {"board": {"1前": {"card": "KN-04", "damage": 2, "health": 1}}}}
    },
    {
      "name": "ジャミング技師: 起動（2）で敵の攻撃力−2（0になると攻撃しない）。ラウンド終了で戻る",
      "refs": ["CY-05", "8.2", "10.4", "15.2"],
      "setup": {"A": {"mana": 2, "board": {"1前": "CY-05"}}, "B": {"board": {"1前": "KN-04"}}},
      "steps": [
        {"type": "activate", "player": "A", "unit": "1前", "targets": {"enemy": {"unit": "A:1前"}}, "illegal": true},
        {"type": "activate", "player": "A", "unit": "1前", "targets": {"enemy": {"unit": "B:1前"}}},
        {"expect": {"A": {"mana": 0}, "B": {"board": {"1前": {"attack": 0}}}}},
        {"do": "combat"},
        {"expect": {"A": {"board": {"1前": {"card": "CY-05", "damage": 0}}}, "B": {"board": {"1前": {"damage": 2}}}}},
        {"do": "endRound"}
      ],
      "expect": {"B": {"board": {"1前": {"card": "KN-04", "attack": 2}}}}
    },
    {
      "name": "ジャミング技師: 起動（2）を予備マナで払い、同じ効果",
      "refs": ["CY-05", "15.2", "16.2"],
      "setup": {"round": 3, "A": {"maxMana": 3, "mana": 0, "reserve": 2, "board": {"1前": "CY-05"}}, "B": {"board": {"2前": "KN-23"}}},
      "steps": [
        {"type": "activate", "player": "A", "unit": "1前", "targets": {"enemy": {"unit": "B:2前"}}}
      ],
      "expect": {"activePlayer": "B", "A": {"reserve": 0, "mana": 0}, "B": {"board": {"2前": {"card": "KN-23", "attack": 4}}}}
    },
    {
      "name": "データ検索: 上から3枚を見て1枚を手札に、残りは元の順で山札の上へ（即効）",
      "refs": ["CY-06", "14.2"],
      "setup": {"A": {"mana": 2, "hand": ["CY-06"], "deck": ["CY-01", "CY-04", "CY-12", "KN-03", "KN-03"]}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-06"},
        {"expect": {"pending": true}},
        {"type": "choose", "player": "A", "card": "CY-04"}
      ],
      "expect": {"pending": false, "activePlayer": "A", "A": {"mana": 0, "hand": ["CY-04"], "deckCount": 4, "deckTop": ["CY-01", "CY-12", "KN-03"], "trash": ["CY-06"]}}
    },
    {
      "name": "データ検索: 強化はない。強化なしで上から3枚を見て、3枚目を選べる",
      "refs": ["CY-06", "15.1"],
      "setup": {"A": {"mana": 4, "hand": ["CY-06"], "deck": ["CY-01", "CY-04", "CY-12", "KN-03", "KN-03"]}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-06", "enhance": true, "illegal": true},
        {"type": "castSpell", "player": "A", "card": "CY-06"},
        {"expect": {"pending": true}},
        {"type": "choose", "player": "A", "card": "CY-12"}
      ],
      "expect": {"pending": false, "activePlayer": "A", "A": {"mana": 2, "hand": ["CY-12"], "deckCount": 4, "deckTop": ["CY-01", "CY-04", "KN-03"]}}
    },
    {
      "name": "量子コピー: 2マナ・即効。敵ユニットと同名のカードを自分の手札に生成して公開する（ダメージは写らない。元のユニットはそのまま）",
      "refs": ["CY-07", "11.7", "14.2"],
      "setup": {"A": {"mana": 5, "hand": ["CY-07"]}, "B": {"board": {"2前": {"card": "KN-09", "damage": 1}}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-07", "targets": {"unit": {"unit": "B:2前"}}},
        {"expect": {"activePlayer": "A", "A": {"mana": 3, "hand": ["KN-09"], "revealed": ["KN-09"], "trash": ["CY-07"]}, "B": {"hand": [], "board": {"2前": {"card": "KN-09", "damage": 1}}}}},
        {"type": "playUnit", "player": "A", "card": "KN-09", "cell": "1前"}
      ],
      "expect": {"A": {"mana": 0, "hand": [], "board": {"1前": {"card": "KN-09", "attack": 3, "health": 2, "damage": 0, "shield": true}}}}
    },
    {
      "name": "量子コピー: 味方のユニットも選べ、トークン専用のカード（動く氷像）もコピーできる",
      "refs": ["CY-07", "11.7"],
      "setup": {"A": {"mana": 2, "hand": ["CY-07"], "board": {"3前": {"card": "TK-01", "token": true}}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-07", "targets": {"unit": {"unit": "A:3前"}}}
      ],
      "expect": {"activePlayer": "A", "A": {"mana": 0, "hand": ["TK-01"], "revealed": ["TK-01"], "handCosts": {"TK-01": 1}, "board": {"3前": {"card": "TK-01"}}}}
    },
    {
      "name": "ゴーストハッカー: 3マナ 2/1で配置し、遊撃で後列を移り、射撃で後列から本体を攻撃する",
      "refs": ["CY-08", "8.2", "14"],
      "setup": {"A": {"mana": 3, "hand": ["CY-08"]}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-08", "cell": "2後"},
        {"expect": {"A": {"mana": 0, "board": {"2後": {"card": "CY-08", "attack": 2, "health": 1, "keywords": ["ranged", "mobile"]}}}}},
        {"type": "pass", "player": "B"},
        {"type": "mobileMove", "player": "A", "unit": "2後", "to": "3後"},
        {"do": "combat"}
      ],
      "expect": {"A": {"board": {"2後": null, "3後": {"card": "CY-08", "damage": 0}}}, "B": {"life": 18}}
    },
    {
      "name": "転送遅延: 3マナ。ユニットと移動先を選び、次の自分の手番の始めに移動する（それまでは動かない。レイの成長は移動したときに数える）",
      "refs": ["CY-09", "14.1", "12", "leader-rei"],
      "setup": {"A": {"mana": 3, "hand": ["CY-09"]}, "B": {"board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "B:1前"}, "cell": {"cell": "B:4後"}}},
        {"expect": {"activePlayer": "B", "A": {"mana": 0, "delayed": ["CY-09"], "leaders": [{}, {"progress": 0}]}, "B": {"board": {"1前": {"card": "KN-03"}, "4後": null}}}},
        {"type": "pass", "player": "B"}
      ],
      "expect": {"activePlayer": "B", "A": {"delayed": [], "trash": ["CY-09"], "leaders": [{}, {"progress": 1}]}, "B": {"board": {"1前": null, "4後": {"card": "KN-03"}}}}
    },
    {
      "name": "転送遅延: 発動までに移動先が埋まっていれば移動しない",
