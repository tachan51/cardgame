      "expect": {"A": {"delayed": [], "trash": ["CY-11"], "board": {"2前": {"damage": 0}}}, "B": {"board": {"2前": null, "2後": {"card": "KN-04", "damage": 2}, "1前": {"damage": 0}}, "trash": ["KN-03"]}}
