{
  "description": "電脳都市（CY-01〜CY-25）とリーダー・レイのカード効果のシナリオ",
  "scenarios": [
    {
      "name": "偵察ドローン: 1マナで配置し、機動で任意の空きマスへ移動できる（1ラウンド1回）",
      "refs": ["CY-01", "14", "7.6"],
      "setup": {"A": {"mana": 1, "hand": ["CY-01"]}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-01", "cell": "2前"},
        {"expect": {"A": {"mana": 0, "board": {"2前": {"card": "CY-01", "attack": 1, "health": 1, "keywords": ["mobile"]}}}}},
        {"type": "pass", "player": "B"},
        {"type": "mobileMove", "player": "A", "unit": "2前", "to": "4後"},
        {"expect": {"A": {"board": {"2前": null, "4後": {"card": "CY-01"}}}}},
        {"type": "pass", "player": "B"},
        {"type": "mobileMove", "player": "A", "unit": "4後", "to": "1前", "illegal": true}
      ],
      "expect": {"activePlayer": "A", "A": {"board": {"4後": {"card": "CY-01"}, "1前": null}}}
    },
    {
      "name": "緊急ログアウト: 味方を手札に戻すとダメージ・強化・盾が消え、即効で続けて行動できる",
      "refs": ["CY-02", "11.7", "14.2"],
      "setup": {"A": {"mana": 3, "hand": ["CY-02"], "board": {"1前": {"card": "KN-04", "damage": 1, "attack": 1, "keywords": ["shield"]}}}, "B": {"board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-02", "targets": {"ally": {"unit": "B:1前"}}, "illegal": true},
        {"type": "castSpell", "player": "A", "card": "CY-02", "targets": {"ally": {"unit": "A:1前"}}},
        {"expect": {"activePlayer": "A", "A": {"mana": 2, "hand": ["KN-04"], "trash": ["CY-02"], "board": {"1前": null}}}},
        {"type": "playUnit", "player": "A", "card": "KN-04", "cell": "2前"}
      ],
      "expect": {"activePlayer": "B", "A": {"mana": 0, "board": {"2前": {"card": "KN-04", "attack": 2, "health": 3, "damage": 0, "shield": false}}}}
    },
    {
      "name": "緊急ログアウト: トークンは手札に戻らず消える",
      "refs": ["CY-02", "11.7"],
      "setup": {"A": {"mana": 1, "hand": ["CY-02"], "board": {"2前": {"card": "CY-01", "token": true}}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-02", "targets": {"ally": {"unit": "A:2前"}}}
      ],
      "expect": {"activePlayer": "A", "A": {"hand": [], "trash": ["CY-02"], "board": {"2前": null}}}
    },
    {
      "name": "警備ドローンMk-II: 起動で先制を得て、相手より先に倒す。先制はラウンド終了で消える",
      "refs": ["CY-03", "8.1", "15.2"],
      "setup": {"A": {"mana": 2, "board": {"1前": "CY-03"}}, "B": {"board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "activate", "player": "A", "unit": "1前"},
        {"expect": {"A": {"mana": 1, "board": {"1前": {"keywords": ["firstStrike", "mobile"]}}}}},
        {"type": "pass", "player": "B"},
        {"type": "activate", "player": "A", "unit": "1前", "illegal": true},
        {"do": "combat"},
        {"expect": {"A": {"board": {"1前": {"card": "CY-03", "damage": 0}}}, "B": {"board": {"1前": null}, "trash": ["KN-03"]}}},
        {"do": "endRound"}
      ],
      "expect": {"A": {"board": {"1前": {"card": "CY-03", "noKeywords": ["firstStrike"]}}}}
    },
    {
      "name": "ストリートサムライ: 先制で正面の2/3を倒し、反撃を受けない",
      "refs": ["CY-04", "8.1"],
      "setup": {"A": {"mana": 2, "hand": ["CY-04"]}, "B": {"board": {"1前": "KN-04"}}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-04", "cell": "1前"},
        {"do": "combat"}
      ],
      "expect": {"A": {"mana": 0, "board": {"1前": {"card": "CY-04", "attack": 3, "damage": 0}}}, "B": {"board": {"1前": null}, "trash": ["KN-04"]}}
    },
    {
      "name": "ジャミング技師: 配置時に敵の攻撃力−2（0になると攻撃しない）。ラウンド終了で戻る",
      "refs": ["CY-05", "8.2", "10.4"],
      "setup": {"A": {"mana": 2, "hand": ["CY-05"]}, "B": {"board": {"1前": "KN-04"}}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-05", "cell": "1前", "targets": {"enemy": {"unit": "B:1前"}}},
        {"expect": {"B": {"board": {"1前": {"attack": 0}}}}},
        {"do": "combat"},
        {"expect": {"A": {"board": {"1前": {"card": "CY-05", "damage": 0}}}, "B": {"board": {"1前": {"damage": 1}}}}},
        {"do": "endRound"}
      ],
      "expect": {"B": {"board": {"1前": {"card": "KN-04", "attack": 2}}}}
    },
    {
      "name": "ジャミング技師: 起動（2）を予備マナで払い、同じ効果",
      "refs": ["CY-05", "15.2", "16.2"],
      "setup": {"round": 3, "A": {"maxMana": 3, "mana": 0, "reserve": 2, "board": {"1前": "CY-05"}}, "B": {"board": {"2前": "KN-23"}}},
      "steps": [
        {"type": "activate", "player": "A", "unit": "1前", "targets": {"enemy": {"unit": "B:2前"}}}
      ],
      "expect": {"activePlayer": "B", "A": {"reserve": 0, "mana": 0}, "B": {"board": {"2前": {"card": "KN-23", "attack": 10}}}}
    },
    {
      "name": "ジャミング技師: 敵ユニットがいなくても配置でき、配置時の効果は何もしない",
      "refs": ["CY-05", "7.1", "11.4"],
      "setup": {"A": {"mana": 2, "hand": ["CY-05"]}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-05", "cell": "3前"}
      ],
      "expect": {"activePlayer": "B", "A": {"mana": 0, "hand": [], "board": {"3前": {"card": "CY-05", "attack": 1, "health": 3}}}}
    },
    {
      "name": "データ検索: 上から2枚を見て1枚を手札に、残りは元の順で山札の上へ（即効）",
      "refs": ["CY-06", "14.2"],
      "setup": {"A": {"mana": 2, "hand": ["CY-06"], "deck": ["CY-01", "CY-04", "CY-12", "KN-03", "KN-03"]}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-06"},
        {"expect": {"pending": true}},
        {"type": "choose", "player": "A", "card": "CY-04"}
      ],
      "expect": {"pending": false, "activePlayer": "A", "A": {"mana": 0, "hand": ["CY-04"], "deckCount": 4, "deckTop": ["CY-01", "CY-12", "KN-03"], "trash": ["CY-06"]}}
    },
    {
      "name": "データ検索（強化）: 上から3枚を見て、3枚目を選べる",
      "refs": ["CY-06", "15.1"],
      "setup": {"A": {"mana": 3, "hand": ["CY-06"], "deck": ["CY-01", "CY-04", "CY-12", "KN-03", "KN-03"]}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-06", "enhance": true},
        {"expect": {"pending": true}},
        {"type": "choose", "player": "A", "card": "CY-12"}
      ],
      "expect": {"pending": false, "activePlayer": "A", "A": {"mana": 0, "hand": ["CY-12"], "deckCount": 4, "deckTop": ["CY-01", "CY-04", "KN-03"]}}
    },
    {
      "name": "オーバークロック: +4/+0で正面を倒し、ラウンド終了時の2ダメージで自壊する",
      "refs": ["CY-07", "6.4", "10.4"],
      "setup": {"A": {"mana": 2, "hand": ["CY-07"], "board": {"1前": "KN-04"}}, "B": {"board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-07", "targets": {"unit": {"unit": "A:1前"}}},
        {"expect": {"A": {"board": {"1前": {"attack": 6}}}}},
        {"do": "combat"},
        {"expect": {"A": {"board": {"1前": {"card": "KN-04", "damage": 2, "health": 1}}}, "B": {"board": {"1前": null}}}},
        {"do": "roundEnd"}
      ],
      "expect": {"A": {"board": {"1前": null}, "trash": ["KN-04", "CY-07"]}}
    },
    {
      "name": "オーバークロック: 敵にも使える。ラウンド終了で攻撃力は戻り、2ダメージが残る",
      "refs": ["CY-07", "11.7", "10.4"],
      "setup": {"A": {"mana": 2, "hand": ["CY-07"]}, "B": {"board": {"3後": "KN-22"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-07", "targets": {"unit": {"unit": "B:3後"}}},
        {"expect": {"B": {"board": {"3後": {"attack": 10}}}}},
        {"do": "roundEnd"}
      ],
      "expect": {"B": {"board": {"3後": {"card": "KN-22", "attack": 6, "damage": 2, "health": 6}}}}
    },
    {
      "name": "オーバークロック: ラウンド終了時の2ダメージは盾で防がれる",
      "refs": ["CY-07", "14"],
      "setup": {"A": {"mana": 2, "hand": ["CY-07"], "board": {"2後": "KN-21"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-07", "targets": {"unit": {"unit": "A:2後"}}},
        {"do": "roundEnd"}
      ],
      "expect": {"A": {"board": {"2後": {"card": "KN-21", "attack": 6, "damage": 0, "shield": false}}}}
    },
    {
      "name": "ゴーストハッカー: 機動で後列を移り、射撃で後列から本体を攻撃する",
      "refs": ["CY-08", "8.2", "14"],
      "setup": {"A": {"mana": 3, "hand": ["CY-08"]}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-08", "cell": "2後"},
        {"type": "pass", "player": "B"},
        {"type": "mobileMove", "player": "A", "unit": "2後", "to": "3後"},
        {"do": "combat"}
      ],
      "expect": {"A": {"board": {"2後": null, "3後": {"card": "CY-08", "damage": 0}}}, "B": {"life": 17}}
    },
    {
      "name": "小型転送: 遅延で敵ユニットを指定した空きマスへ移動（レイの成長に数える）",
      "refs": ["CY-09", "14.1", "leader-rei"],
      "setup": {"A": {"mana": 2, "hand": ["CY-09"]}, "B": {"board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "B:1前"}, "cell": {"cell": "B:4後"}}},
        {"expect": {"activePlayer": "B", "A": {"delayed": ["CY-09"]}, "B": {"board": {"1前": {"card": "KN-03"}, "4後": null}}}},
        {"type": "pass", "player": "B"}
      ],
      "expect": {"activePlayer": "B", "passStreak": 0, "A": {"delayed": [], "trash": ["CY-09"], "leaders": [{}, {"progress": 1}]}, "B": {"board": {"1前": null, "4後": {"card": "KN-03"}}}}
    },
    {
      "name": "小型転送: 発動時に指定マスが空きマスでなくなっていれば何もしない",
      "refs": ["CY-09", "14.1"],
      "setup": {"A": {"mana": 2, "hand": ["CY-09"]}, "B": {"mana": 2, "hand": ["KN-04"], "board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "B:1前"}, "cell": {"cell": "B:4後"}}},
        {"type": "playUnit", "player": "B", "card": "KN-04", "cell": "4後"}
      ],
      "expect": {"activePlayer": "B", "A": {"delayed": [], "trash": ["CY-09"], "leaders": [{}, {"progress": 0}]}, "B": {"board": {"1前": {"card": "KN-03"}, "4後": {"card": "KN-04"}}}}
    },
    {
      "name": "小型転送: 発動時に攻撃力が3を超えていれば移動しない",
      "refs": ["CY-09", "14.1"],
      "setup": {"A": {"mana": 2, "hand": ["CY-09"]}, "B": {"mana": 2, "hand": ["CY-07"], "board": {"1前": "KN-03"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "B:1前"}, "cell": {"cell": "B:4後"}}},
        {"type": "castSpell", "player": "B", "card": "CY-07", "targets": {"unit": {"unit": "B:1前"}}},
        {"expect": {"B": {"board": {"1前": {"attack": 6}}}}}
      ],
      "expect": {"activePlayer": "B", "A": {"delayed": [], "leaders": [{}, {"progress": 0}]}, "B": {"board": {"1前": {"card": "KN-03", "attack": 6}, "4後": null}}}
    },
    {
      "name": "小型転送: 対象のユニットが移動しても追いかけて、指定マスへ移動させる",
      "refs": ["CY-09", "14.1"],
      "setup": {"A": {"mana": 2, "hand": ["CY-09"]}, "B": {"board": {"1前": "CY-01"}}},
      "steps": [
        {"type": "castSpell", "player": "A", "card": "CY-09", "targets": {"unit": {"unit": "B:1前"}, "cell": {"cell": "B:4後"}}},
        {"type": "mobileMove", "player": "B", "unit": "1前", "to": "2前"}
      ],
      "expect": {"activePlayer": "B", "B": {"board": {"1前": null, "2前": null, "4後": {"card": "CY-01"}}}, "A": {"leaders": [{}, {"progress": 1}]}}
    },
    {
      "name": "路地裏の運び屋: 配置時にカードを1枚引く",
      "refs": ["CY-10", "11.6"],
      "setup": {"A": {"mana": 3, "hand": ["CY-10"], "deck": ["CY-04", "KN-03"]}},
      "steps": [
        {"type": "playUnit", "player": "A", "card": "CY-10", "cell": "1後"}
